[submodule "docs-resources"]
	path = docs-resources
	url = https://github.com/riscv/docs-resources.git

# The three upstreams below are pristine checkouts that zvknhk/scripts/apply-*.sh
# patch in place at build time. That dirties each work tree, so `ignore = dirty`
# keeps `git status` clean; a changed pinned commit still shows up.
#
# `update = none` keeps a recursive submodule update -- `git clone
# --recurse-submodules`, and the `submodules: recursive` checkout in the
# document workflows -- from cloning them: the specification build needs only
# docs-resources, and Antora scans the whole work tree, where QEMU's nested
# submodules carry a broken symbolic link. The zvknhk Makefile fetches each one
# on demand with `git submodule update --init --checkout`.

[submodule "zvknhk/riscv-isa-sim"]
	path = zvknhk/riscv-isa-sim
	url = https://github.com/riscv-software-src/riscv-isa-sim.git
	ignore = dirty
	update = none

[submodule "zvknhk/qemu-src"]
	path = zvknhk/qemu-src
	url = https://gitlab.com/qemu-project/qemu.git
	ignore = dirty
	update = none

[submodule "zvknhk/demo/openssl"]
	path = zvknhk/demo/openssl
	url = https://github.com/openssl/openssl.git
	ignore = dirty
	update = none
	# OpenSSL's full history is large and only one release is ever needed here.
	shallow = true
